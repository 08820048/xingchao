# 星潮 bot 本地开发环境（生产环境用 .env.prod，容器内会以 .env.prod 覆盖 .env）
# 本地联调：配合 scripts/mock_napcat.py 使用，无需真实 QQ
ENVIRONMENT=dev
HOST=0.0.0.0
PORT=8080
DRIVER=~fastapi+~httpx+~websockets
LOG_LEVEL=INFO
SUPERUSERS=[]
XINGCHAO_SUPERUSERS=10001
COMMAND_START=["/", "星潮"]
NICKNAME=["星潮", "xingchao"]
ONEBOT_ACCESS_TOKEN=local-test-token-123456
XINGCHAO_GROUP_WHITELIST=555666777
XINGCHAO_LOG_DIR=./data/logs
XINGCHAO_DB_PATH=./data/xingchao.db
XINGCHAO_REPLIES_PATH=./data/replies.json
XINGCHAO_REPLY_COOLDOWN=8
XINGCHAO_SITE=https://xingchao.dev

# Web 管理面板密码
XINGCHAO_PANEL_PASSWORD=local-panel
