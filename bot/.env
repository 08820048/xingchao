# 星潮 bot 本地开发环境（生产环境用 .env.prod，容器内会以 .env.prod 覆盖 .env）
ENVIRONMENT=dev
HOST=0.0.0.0
PORT=8080
DRIVER=~fastapi+~httpx+~websockets
LOG_LEVEL=DEBUG
SUPERUSERS=[]
XINGCHAO_SUPERUSERS=
COMMAND_START=["/", "星潮"]
NICKNAME=["星潮", "xingchao"]
ONEBOT_ACCESS_TOKEN=
XINGCHAO_GROUP_WHITELIST=
XINGCHAO_LOG_DIR=./data/logs
XINGCHAO_DB_PATH=./data/xingchao.db
XINGCHAO_REPLIES_PATH=./data/replies.json
XINGCHAO_REPLY_COOLDOWN=8
XINGCHAO_SITE=https://xingchao.dev
