HOST=0.0.0.0
PORT=8080
ENVIRONMENT=prod
DRIVER=~fastapi+~httpx+~websockets
LOG_LEVEL=INFO
SUPERUSERS=["123456789"]
# 与根目录 .env 的 XINGCHAO_SUPERUSERS 保持一致；compose 注入的环境变量会覆盖这里的值
XINGCHAO_SUPERUSERS=123456789
COMMAND_START=["/", "星潮"]
NICKNAME=["星潮", "xingchao"]
ONEBOT_ACCESS_TOKEN=change-me-long-random
ONEBOT_V11_SECRET=
XINGCHAO_GROUP_WHITELIST=111111111,222222111
XINGCHAO_LOG_DIR=/app/data/logs
XINGCHAO_DB_PATH=/app/data/xingchao.db
XINGCHAO_REPLIES_PATH=/app/data/replies.json
XINGCHAO_REPLY_COOLDOWN=8
XINGCHAO_SITE=https://xingchao.dev

# Web 管理面板密码（实际值由根目录 .env 的同名环境变量覆盖）
XINGCHAO_PANEL_PASSWORD=

# ─── 第三方插件 ───
# 口僻（miao）：机器人发言随机加「喵」，默认概率 0.5 太高，调低避免刷屏
MIAO_WORDS=["喵"]
MIAO_PROBABILITY=0.15
MIAO_POSITION=end
MIAO_COUNT=1
# 娶群友 CP 卡片字体（容器内已装文泉驿微米黑）
GROUPMATE_WAIFU_FONTNAME=WenQuanYi Micro Hei
# 和风天气（自写文本版 /天气 用，不配置则 /天气 提示未配置）：https://console.qweather.com
# 创建项目 → 上传 Ed25519 公钥获取 KID → 项目ID填 SUB；私钥支持 base64 或 \n 转义的 PEM
QWEATHER_JWT_SUB=
QWEATHER_JWT_KID=
QWEATHER_JWT_PRIVATE_KEY=
QWEATHER_API_HOST=https://api.qweather.com
# 互联网异常事件监测（Cloudflare Radar 免费申请：https://radar.cloudflare.com）
# 不填 token 也能加载，但不会推送；outage_group_id 填接收推送的群号列表
OUTAGE_CF_TOKEN=
OUTAGE_GROUP_ID=[]
# Bot 上下线邮件通知（不配则不发；JSON 格式，port 用 465 为 SSL）
MAIL_NOTICE={"username": "", "password": "", "hostname": "", "port": 587}
