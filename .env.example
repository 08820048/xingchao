# 星潮 Xingchao 根环境变量（复制为 .env 后填写真实值）
# bot 容器与 napcat 容器共用本文件（compose env_file）

# 超管 QQ 号，多个用英文逗号分隔；必须与 bot/.env.prod 的 SUPERUSERS 保持一致
XINGCHAO_SUPERUSERS=123456789

# 群白名单，逗号分隔；留空 = 不处理任何群（安全默认）
XINGCHAO_GROUP_WHITELIST=111111111,222222111

# OneBot 反向 WS 访问令牌，生产环境必须至少 16 位随机字符串
ONEBOT_ACCESS_TOKEN=change-me-long-random

# NapCat 容器内运行用户（一般为宿主机 uid/gid，避免挂载目录权限问题）
NAPCAT_UID=1000
NAPCAT_GID=1000

# Web 管理面板密码（/panel，映射在 127.0.0.1:8081）；留空则启动时随机生成并打印在 bot 日志
XINGCHAO_PANEL_PASSWORD=change-me-panel-password

# —— AI 问答（可选；不填则 AI 功能自动禁用，配置后可在面板「AI」页调整其余项）——
# OpenAI 兼容接口地址（B.AI 示例：https://api.b.ai/v1）
XINGCHAO_AI_BASE_URL=https://api.b.ai/v1
# 对应 API Key
XINGCHAO_AI_API_KEY=sk-xxx

# —— 开发者信息（AI 回答「开发者是谁」与 /关于星潮 使用）——
XINGCHAO_DEVELOPER_ID=2217021563
XINGCHAO_DEVELOPER_BLOG=https://xuyi.dev
# 项目官网默认 https://xingchao.dev，如需修改：
# XINGCHAO_DEVELOPER_SITE=https://xingchao.dev

# 容器时区（AI 时间回答 / 定时任务 / 日志均按此时区）
TZ=Asia/Shanghai
